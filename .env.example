# Copy to .env and fill in. Never commit .env.
# Exchange keys: sandbox/testnet, trading only, withdrawals off, IP allowlisted.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
OPENROUTER_API_KEY=
FASTROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Live trading needs this AND live_trading: true in config/settings.yaml.
LIVE_TRADING=false
# Docker build only: a package mirror, when public PyPI is blocked. Copy the values from your pip.conf.
# PIP_INDEX_URL=https://mirror.example/simple
# PIP_EXTRA_INDEX_URL=https://mirror2.example/simple
# PIP_TRUSTED_HOST=mirror.example mirror2.example
